# ================================
# maki-land — .gitignore
# ================================

# ---- macOS build artifacts ----
.build/
*.o
*.d
DynamicIsland.app/
makiland.app/
*.dmg
*.zip

# ---- macOS system files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
*.swp
*.swo

# ---- Xcode / SPM ----
*.xcodeproj/
*.xcworkspace/
xcuserdata/
.swiftpm/
Package.resolved

# ---- Windows build artifacts ----
maki-land-windows/node_modules/
maki-land-windows/dist/
maki-land-windows/dist-electron/
maki-land-windows/release/
maki-land-windows/.vite/

# ---- Secrets / API keys (NEVER commit these!) ----
# Keys disimpan di OS per-user (AppData/applicationSupport), bukan di sini
.env
.env.local
.env.*
secrets.json
*_secrets.*

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*

# ---- Temp / scratch ----
tmp/
*.tmp
*.temp

# ---- ZIP distribution (build artifact) ----
maki-land-windows.zip
